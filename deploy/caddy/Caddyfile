# Poliscope's single public entrypoint.
#
# `web`'s own nginx already splits /api/* (proxied to the api container,
# including the unbuffered SSE workspace stream) from the static build --
# see apps/web/nginx.conf. So Caddy does not need to know that split exists;
# it only has to forward everything to `web:80`.
#
# Access control lives in the application now: the account system (register /
# login, per-account isolation) replaced the shared-password gate. The API
# answers 401 to any request without a valid bearer token, and the frontend
# shows the login screen when none is remembered. Caddy's job is purely
# transport: forward everything, let the API decide who gets in.
#
# {$POLISCOPE_SITE_ADDRESS} is a bare port (":80") until a real domain is set
# in .env, at which point Caddy's automatic HTTPS takes over with no other
# change here -- that is the whole point of fronting with Caddy instead of
# nginx directly.
{$POLISCOPE_SITE_ADDRESS} {
	handle {
		reverse_proxy web:80
	}
}
