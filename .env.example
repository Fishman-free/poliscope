# Copy to .env and fill in before `docker compose up --build`.
# No real credentials belong in this file -- it is committed to git.

# --- Postgres superuser (used only by the one-shot `migrate` service to run
# alembic and create the poliscope_app / poliscope_projector roles) ---
POLISCOPE_DB_SUPERUSER=poliscope_admin
POLISCOPE_DB_SUPERUSER_PASSWORD=change-me
POLISCOPE_DB_NAME=poliscope

# --- Application database roles (created by the migration, not by Postgres
# itself -- see migrations/versions/0001_research_and_calls.py) ---
POLISCOPE_APP_DATABASE_PASSWORD=change-me-too
POLISCOPE_PROJECTOR_DATABASE_PASSWORD=change-me-as-well

# --- Host port mapping (defaults chosen to avoid colliding with anything
# already running on the developer's machine; override if it clashes).
# The mapping binds loopback (127.0.0.1) only: `api` and `worker` reach
# Postgres over the compose-internal network, so the host port exists solely
# for your own psql / backup access and is never exposed to the public
# internet, even on a cloud host with a public IP. `api` and `web` bind no
# host port at all -- `caddy` (below) is the only public entrypoint. ---
POLISCOPE_DB_HOST_PORT=55440

# --- Public entrypoint (deploy/caddy) ---
# Caddy is the only service reachable from outside the machine. Left at
# ":80" it serves plain HTTP on port 80 -- fine for localhost or a bare cloud
# IP with no domain yet. Once you point a real domain at this host, change
# POLISCOPE_SITE_ADDRESS to that domain (e.g. "poliscope.example.com") and
# Caddy automatically requests and renews a real HTTPS certificate for it --
# no other change needed anywhere in this stack.
#
# Access control lives in the application: the account system (register /
# login, per-account isolation) replaced the old shared-password gate. The
# legacy POLISCOPE_SITE_USERNAME / POLISCOPE_SITE_PASSWORD variables have
# been fully removed from the stack -- do not define them here.
POLISCOPE_SITE_ADDRESS=:80

# --- Model gateway (packages/models/openai_compatible.py) ---
# Any OpenAI-Chat-Completions-compatible endpoint: DeepSeek, LongCat, a
# domestic relay station, etc. Leave blank to run with no model vendor
# configured -- the worker then reports an honest COMPLETED_WITH_GAPS
# instead of failing (see apps/worker/main.py's WorkerContext docstring).
# NEVER point these at this Claude Code session's own ANTHROPIC_AUTH_TOKEN /
# ANTHROPIC_BASE_URL -- those belong to Claude Code's own connection to
# Anthropic, not to Poliscope's model gateway.
POLISCOPE_MODEL_API_KEY=
POLISCOPE_MODEL_BASE_URL=
POLISCOPE_MODEL_NAME=
POLISCOPE_MODEL_NAME_STRONG_REASONING=
POLISCOPE_MODEL_NAME_MEDIUM=
POLISCOPE_MODEL_NAME_LIGHTWEIGHT=

# --- Free-trial model (round-7) ---
# DashScope API key for the deployment's free qwen3.8-max trial: every
# account may use it twice (see Model Settings in the web UI). Stored
# server-side like any other saved key and never shown to clients. Leave
# blank to disable the trial entirely.
DASHSCOPE_API_KEY=

# --- Tool gateway (packages/tools/http_gateway.py) ---
# OpenAlex, Crossref, and Semantic Scholar need no credential. Unpaywall needs
# a contact email by its own terms of use.
POLISCOPE_TOOLS_CONTACT_EMAIL=
POLISCOPE_TOOLS_SEMANTIC_SCHOLAR_API_KEY=
